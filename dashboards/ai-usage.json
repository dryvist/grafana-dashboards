{
  "uid": "ai-usage",
  "title": "AI usage",
  "description": "Cross-fabric AI usage rollup: tokens/cost per day by agent/tier/model/device, local serving throughput, router error/fallback rates, Claude Code cache economics, Codex/Hermes activity, and Langfuse trace volume. Sourced from claude-code-metrics/cache-economics/subagents-tools (this repo) plus the LiteLLM router's own Prometheus metrics. Panels using litellm_* metric names are UNVERIFIED against a live proxy as of authoring — see docs/AI_OBSERVABILITY.md for the verification note before treating this as demo-ready.",
  "tags": ["ai-observability", "overview"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5m",
  "time": { "from": "now-7d", "to": "now" },
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "agent",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "victoriametrics" },
        "includeAll": true,
        "multi": true,
        "refresh": 1,
        "query": "label_values(claude_jsonl_cost_usd_total, repo)",
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "claude_codex_user",
        "label": "Claude / Codex identity",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "victoriametrics" },
        "includeAll": true,
        "multi": true,
        "refresh": 1,
        "query": "label_values(claude_code_token_usage_tokens_total, enduser_id)",
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "litellm_user_email",
        "label": "LiteLLM identity",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "victoriametrics" },
        "includeAll": true,
        "multi": true,
        "refresh": 1,
        "query": "label_values(litellm_input_tokens_metric_total, user_email)",
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Cost by day (Claude Code JSONL ETL)",
      "description": "Daily USD, summed across every repo the ETL attributes a session to. Codex/Hermes cost is not yet in this series — see 'Codex turns' and 'Hermes calls' panels for their own activity counters until a comparable cost figure is derived for them.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "editorMode": "code",
          "expr": "sum(increase(claude_jsonl_cost_usd_total{repo=~\"$agent\"}[1d])) by (repo)",
          "legendFormat": "{{repo}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Cost by tier (local vs subscription)",
      "description": "Requires the router's litellm_spend_metric_total to expose metadata.tier as a label. Router callback settings (60-ops.yml) confirmed enabled this pass; the exact label set exposed by this deployment's LiteLLM version is UNVERIFIED — CIDR-blocked from a live query. If the label is absent, this panel needs metadata.tier promoted via a Prometheus relabel in the callback, not a new exporter.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "editorMode": "code",
          "expr": "sum(increase(litellm_spend_metric_total[7d])) by (tier)",
          "legendFormat": "{{tier}}",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "colorMode": "value" }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Tokens by model",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "editorMode": "code",
          "expr": "sum(increase(claude_jsonl_cache_read_tokens_total{repo=~\"$agent\"}[1d])) by (model) + sum(increase(claude_jsonl_cache_creation_tokens_total{repo=~\"$agent\"}[1d])) by (model)",
          "legendFormat": "{{model}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Local tok/s per backend",
      "description": "mlx-served throughput per model, sourced from the local-serving stack's own gauge. Metric name matches this estate's mlx-preflight/serving convention (mlx_serving_tokens_per_second) — UNVERIFIED live this pass.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "editorMode": "code",
          "expr": "mlx_serving_tokens_per_second",
          "legendFormat": "{{model}} ({{host}})",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Router error / fallback rate",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "editorMode": "code",
          "expr": "sum(rate(litellm_deployment_failure_responses_total[5m])) / clamp_min(sum(rate(litellm_requests_metric_total[5m])), 0.001)",
          "legendFormat": "error rate",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "editorMode": "code",
          "expr": "sum(rate(litellm_deployment_failed_fallbacks_total[5m])) + sum(rate(litellm_deployment_successful_fallbacks_total[5m]))",
          "legendFormat": "fallback rate",
          "range": true,
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Claude Code cache write/read ratio",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "x": 12, "y": 16, "w": 6, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "editorMode": "code",
          "expr": "sum(increase(claude_jsonl_cache_creation_tokens_total[$__range])) / clamp_min(sum(increase(claude_jsonl_cache_read_tokens_total[$__range])), 1)",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 3 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "colorMode": "value" }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Codex turns (24h)",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "x": 18, "y": 16, "w": 6, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "editorMode": "code",
          "expr": "sum(increase(codex_conversation_turn_count_total[24h]))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "colorMode": "value" }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Langfuse traces (24h)",
      "description": "Langfuse's own metrics are not scraped by this stack today — this panel is a placeholder pending either a Langfuse Prometheus exporter or a periodic ETL push of its trace-count API into VictoriaMetrics (langfuse_traces_total). Do not ship this panel as-is if it renders 'No data' at demo time; pull the count from the Langfuse API directly instead until the metric exists.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "x": 6, "y": 24, "w": 6, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "editorMode": "code",
          "expr": "sum(increase(langfuse_traces_total[24h]))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "colorMode": "value" }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Daily tokens by tier and billing class",
      "description": "Native one-day increases from Claude Code and Codex subscription counters, plus LiteLLM local Qwen and OpenRouter counters. Use the identity variables to filter Claude/Codex and LiteLLM paid series. Claude and Codex series are mapped by model; Codex is selected by ChatGPT auth mode. Local Qwen series are global and have no operator attribution. OpenRouter usage is paid and remains tier=unmapped unless the source model is covered by an explicit mapping. Missing series are gaps, not zero. LiteLLM has no cache-write counter; Codex input includes cached input and its token types remain separate. Claude request counts are unavailable and Codex turn counts are not API requests.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "x": 0, "y": 32, "w": 24, "h": 10 },
      "timeFrom": "30d",
      "interval": "1d",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "editorMode": "code",
          "expr": "label_replace(label_replace(sum by (model,type) (increase(claude_code_token_usage_tokens_total{enduser_id=~\"$claude_codex_user\",model=\"claude-fable-5-1\"}[1d])), \"tier\", \"T4\", \"model\", \".*\"), \"billing_class\", \"subscription\", \"model\", \".*\") or label_replace(label_replace(sum by (model,type) (increase(claude_code_token_usage_tokens_total{enduser_id=~\"$claude_codex_user\",model=~\"claude-sonnet-5.*\"}[1d])), \"tier\", \"T2\", \"model\", \".*\"), \"billing_class\", \"subscription\", \"model\", \".*\") or label_replace(label_replace(sum by (model,type) (increase(claude_code_token_usage_tokens_total{enduser_id=~\"$claude_codex_user\",model=~\"claude-opus-5.*\"}[1d])), \"tier\", \"T3\", \"model\", \".*\"), \"billing_class\", \"subscription\", \"model\", \".*\")",
          "legendFormat": "{{tier}} / {{billing_class}} / {{model}} / {{type}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "editorMode": "code",
          "expr": "label_replace(label_replace(sum by (model,token_type) (increase(codex_turn_token_usage_sum{auth_mode=\"Chatgpt\",enduser_id=~\"$claude_codex_user\",model=~\"gpt-5.6-luna|gpt-6-luna\"}[1d])), \"tier\", \"T1\", \"model\", \".*\"), \"billing_class\", \"subscription\", \"model\", \".*\") or label_replace(label_replace(sum by (model,token_type) (increase(codex_turn_token_usage_sum{auth_mode=\"Chatgpt\",enduser_id=~\"$claude_codex_user\",model=~\"gpt-5.6-terra\"}[1d])), \"tier\", \"T2\", \"model\", \".*\"), \"billing_class\", \"subscription\", \"model\", \".*\") or label_replace(label_replace(sum by (model,token_type) (increase(codex_turn_token_usage_sum{auth_mode=\"Chatgpt\",enduser_id=~\"$claude_codex_user\",model=~\"gpt-5.6-sol|gpt-6-sol|gpt-6.1-sol\"}[1d])), \"tier\", \"T3\", \"model\", \".*\"), \"billing_class\", \"subscription\", \"model\", \".*\") or label_replace(label_replace(sum by (model,token_type) (increase(codex_turn_token_usage_sum{auth_mode=\"Chatgpt\",enduser_id=~\"$claude_codex_user\",model=~\"gpt-6-astra\"}[1d])), \"tier\", \"T4\", \"model\", \".*\"), \"billing_class\", \"subscription\", \"model\", \".*\")",
          "legendFormat": "{{tier}} / {{billing_class}} / {{model}} / {{token_type}}",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "editorMode": "code",
          "expr": "label_replace(label_replace(label_replace(sum by (model) (increase(litellm_input_tokens_metric_total{model=~\".*[Qq]wen.*\"}[1d])), \"token_type\", \"input\", \"model\", \".*\"), \"tier\", \"T1\", \"model\", \".*\"), \"billing_class\", \"local\", \"model\", \".*\") or label_replace(label_replace(label_replace(sum by (model) (increase(litellm_output_tokens_metric_total{model=~\".*[Qq]wen.*\"}[1d])), \"token_type\", \"output\", \"model\", \".*\"), \"tier\", \"T1\", \"model\", \".*\"), \"billing_class\", \"local\", \"model\", \".*\") or label_replace(label_replace(label_replace(sum by (model) (increase(litellm_provider_cache_read_input_tokens_metric_total{model=~\".*[Qq]wen.*\"}[1d])), \"token_type\", \"cacheRead\", \"model\", \".*\"), \"tier\", \"T1\", \"model\", \".*\"), \"billing_class\", \"local\", \"model\", \".*\")",
          "legendFormat": "{{tier}} / {{billing_class}} / {{model}} / {{token_type}}",
          "range": true,
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "editorMode": "code",
          "expr": "label_replace(label_replace(label_replace(sum by (model) (increase(litellm_input_tokens_metric_total{api_provider=\"openrouter\",user_email=~\"$litellm_user_email\"}[1d])), \"token_type\", \"input\", \"model\", \".*\"), \"tier\", \"unmapped\", \"model\", \".*\"), \"billing_class\", \"paid\", \"model\", \".*\") or label_replace(label_replace(label_replace(sum by (model) (increase(litellm_output_tokens_metric_total{api_provider=\"openrouter\",user_email=~\"$litellm_user_email\"}[1d])), \"token_type\", \"output\", \"model\", \".*\"), \"tier\", \"unmapped\", \"model\", \".*\"), \"billing_class\", \"paid\", \"model\", \".*\") or label_replace(label_replace(label_replace(sum by (model) (increase(litellm_provider_cache_read_input_tokens_metric_total{api_provider=\"openrouter\",user_email=~\"$litellm_user_email\"}[1d])), \"token_type\", \"cacheRead\", \"model\", \".*\"), \"tier\", \"unmapped\", \"model\", \".*\"), \"billing_class\", \"paid\", \"model\", \".*\")",
          "legendFormat": "{{tier}} / {{billing_class}} / {{model}} / {{token_type}}",
          "range": true,
          "refId": "D"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    }
  ]
}
