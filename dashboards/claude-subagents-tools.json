{
  "uid": "claude-subagents-tools",
  "title": "Claude Code — Subagents & Tools",
  "description": "How much work is delegated to subagents, what it costs, and how the edit tools are performing. Subagent attribution comes from the session-log ETL; the exporter cannot separate it from main-session usage.",
  "tags": [
    "claude-code",
    "ai-observability",
    "subagents"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "repo",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "includeAll": true,
        "multi": true,
        "refresh": 1,
        "query": "label_values(claude_jsonl_cache_read_tokens_total, repo)",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "includeAll": true,
        "multi": true,
        "refresh": 1,
        "query": "label_values(claude_jsonl_cache_read_tokens_total, model)",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Subagent share of cache reads",
      "description": "Measured at roughly a quarter of all read volume across history. The exporter cannot attribute this — subagent usage is recorded in separate session-log files, and the parent session's records do not carry it.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "sum(increase(claude_jsonl_cache_read_tokens_total{agent=\"subagent\"}[$__range])) / clamp_min(sum(increase(claude_jsonl_cache_read_tokens_total[$__range])), 1)",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Subagent output tokens",
      "description": "Output produced by subagents.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "sum(increase(claude_jsonl_output_tokens_total{agent=\"subagent\"}[$__range]))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
