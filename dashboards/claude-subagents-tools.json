        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Token volume: main vs subagent",
      "description": "Where the work is actually happening.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 13,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "sum by (agent) (rate(claude_jsonl_cache_read_tokens_total[$__rate_interval]))",
          "legendFormat": "cache read {{agent}}",
          "range": true,
          "instant": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "sum by (agent) (rate(claude_jsonl_cache_creation_tokens_total[$__rate_interval]))",
          "legendFormat": "cache write {{agent}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "piechart",
      "title": "Cache reads by agent",
      "description": "Main-session versus subagent share of read volume.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
