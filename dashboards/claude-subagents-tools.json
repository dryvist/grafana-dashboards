{
  "uid": "claude-subagents-tools",
  "title": "Claude Code \u2014 Subagents & Tools",
  "description": "How much work is delegated to subagents, what it costs, and how the edit tools are performing. Subagent attribution comes from the transcript ETL; the exporter cannot separate it from main-session usage.",
  "tags": [
    "claude-code",
    "ai-observability",
    "subagents"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "repo",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "includeAll": true,
        "multi": true,
        "refresh": 1,
        "query": "label_values(claude_jsonl_cache_read_tokens_total, repo)",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "includeAll": true,
        "multi": true,
        "refresh": 1,
        "query": "label_values(claude_jsonl_cache_read_tokens_total, model)",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Subagent share of cache reads",
      "description": "Measured at roughly a quarter of all read volume across history. The exporter cannot attribute this \u2014 subagent usage is recorded in separate transcript files, and the parent session's records do not carry it.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "sum(increase(claude_jsonl_cache_read_tokens_total{agent=\"subagent\"}[$__range])) / clamp_min(sum(increase(claude_jsonl_cache_read_tokens_total[$__range])), 1)",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Subagent output tokens",
      "description": "Output produced by subagents.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "sum(increase(claude_jsonl_output_tokens_total{agent=\"subagent\"}[$__range]))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Subagent messages",
      "description": "Assistant turns inside subagents.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "sum(increase(claude_jsonl_messages_total{agent=\"subagent\"}[$__range]))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Read amplification: subagent vs main",
      "description": "Cache-read tokens per message in subagents, divided by the same figure for main sessions. Above 1 means each subagent turn carries more context than a main-session turn \u2014 the signal that a subagent is being handed a larger prompt than the work needs.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "(sum(increase(claude_jsonl_cache_read_tokens_total{agent=\"subagent\"}[$__range])) / clamp_min(sum(increase(claude_jsonl_messages_total{agent=\"subagent\"}[$__range])), 1)) / clamp_min(sum(increase(claude_jsonl_cache_read_tokens_total{agent=\"main\"}[$__range])) / clamp_min(sum(increase(claude_jsonl_messages_total{agent=\"main\"}[$__range])), 1), 1)",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Tool decisions",
      "description": "Native counter of edit-tool accept/reject decisions.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
