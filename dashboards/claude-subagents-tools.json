          },
          "editorMode": "code",
          "expr": "sum by (agent) (increase(claude_jsonl_cache_read_tokens_total[$__range]))",
          "legendFormat": "{{agent}}",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
