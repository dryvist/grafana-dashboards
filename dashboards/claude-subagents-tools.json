    {
      "id": 4,
      "type": "stat",
      "title": "Read amplification: subagent vs main",
      "description": "Cache-read tokens per message in subagents, divided by the same figure for main sessions. Above 1 means each subagent turn carries more context than a main-session turn — the signal that a subagent is being handed a larger prompt than the work needs.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "(sum(increase(claude_jsonl_cache_read_tokens_total{agent=\"subagent\"}[$__range])) / clamp_min(sum(increase(claude_jsonl_messages_total{agent=\"subagent\"}[$__range])), 1)) / clamp_min(sum(increase(claude_jsonl_cache_read_tokens_total{agent=\"main\"}[$__range])) / clamp_min(sum(increase(claude_jsonl_messages_total{agent=\"main\"}[$__range])), 1), 1)",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto",
        "colorMode": "value"
      }
    },
