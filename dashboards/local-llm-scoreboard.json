{
  "annotations": {
    "list": []
  },
  "description": "Local serving lanes gpu-primary, gpu-secondary and mac-primary: slot duty cycle per lane and the context-weighted aggregate across lanes lead as the utilization KPI, with VRAM utilization and total tokens per second (1h, 4h, 12h and 24h means) as reference metrics. Token utilization, token throughput against each lane's maximum generation rate, and GPU duty cycle are secondary signals. Router requests and output tokens per hour show local (api_provider hosted_vllm, or api_provider openai with a model from the cents meter's local model list) and cloud (everything else) traffic in separate panels that are never summed. The litellm-internal-health-check team is excluded.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 2,
  "links": [
    {
      "asDropdown": false,
      "icon": "dashboard",
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "targetBlank": false,
      "title": "Local LLM KPI trends",
      "tooltip": "History view of the same lanes",
      "type": "link",
      "url": "/d/local-llm-kpi-trends"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "GPU primary · 4h slot duty cycle",
      "description": "Four-hour average of accelerator:slot_duty_cycle:ratio, in-flight requests divided by serving slots: red below 50%, yellow from 50%, green from 75%. A missing series shows 0.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "green",
                "value": 75
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "100 * avg_over_time(accelerator:slot_duty_cycle:ratio{accelerator=\"gpu-primary\"}[4h]) or on() vector(0)",
          "legendFormat": "GPU primary",
          "instant": true,
          "range": false
        }
      ]
    },
