{
  "uid": "pgbackrest-backups",
  "title": "pgBackRest backups",
  "description": "Backup age and last backup error status, grouped by stanza.",
  "tags": ["postgresql", "backups"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "editable": false,
  "graphTooltip": 1,
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Full backup age per stanza",
      "description": "Age of the latest full backup. The warning threshold is 8 days.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 4},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "No stanza samples",
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 691200}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "editorMode": "code",
          "expr": "min by (stanza) (pgbackrest_backup_since_last_completion_seconds{backup_type=\"full\"})",
          "legendFormat": "{{stanza}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Newest backup age per stanza",
      "description": "Age of the newest completed backup across all backup types. The warning threshold is 30 hours.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {"x": 0, "y": 4, "w": 24, "h": 4},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "No stanza samples",
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 108000}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "editorMode": "code",
          "expr": "min by (stanza) (pgbackrest_backup_since_last_completion_seconds)",
          "legendFormat": "{{stanza}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Last backup error status per stanza",
      "description": "Status of the latest full, differential or incremental backup. A value of 1 indicates one or more page checksum errors.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {"x": 0, "y": 8, "w": 24, "h": 4},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No stanza samples",
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "editorMode": "code",
          "expr": "max by (stanza) (pgbackrest_backup_last_error_status{backup_type=\"incr\"})",
          "legendFormat": "{{stanza}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Newest backup age over time",
      "description": "Age of the newest completed backup across all backup types, grouped by stanza. Alert thresholds are 30 hours and 8 days.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {"x": 0, "y": 12, "w": 24, "h": 10},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "No stanza samples",
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisPlacement": "auto",
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 108000},
              {"color": "yellow", "value": 691200}
            ],
            "showThresholdLabels": false,
            "showThresholdMarkers": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "victoriametrics"},
          "editorMode": "code",
          "expr": "min by (stanza) (pgbackrest_backup_since_last_completion_seconds)",
          "legendFormat": "{{stanza}}",
          "instant": false,
          "range": true
        }
      ]
    }
  ]
}
