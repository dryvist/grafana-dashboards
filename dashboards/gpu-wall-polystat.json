{
  "uid": "gpu-wall-polystat",
  "title": "GPU wall",
  "description": "Beta. Accelerator composites cycle through available busy, power, decode, and sample-age values. Their color always reflects the worst member state. Busy below the operator's 50% target is amber; sample age above 2 minutes is red. Missing telemetry is unknown. Each accelerator has a fixed panel so an absent entity remains visible as no data.",
  "tags": [
    "ai-observability",
    "beta"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 0,
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "grafana-polystat-panel",
      "pluginVersion": "2.1.16",
      "title": "gpu-primary",
      "description": "Green: busy ≥50% and available telemetry ≤2 minutes old. Amber: busy <50%. Red: any rule, hardware, power, or engine source sample >2 minutes old. MetricsQL tlast_over_time reads raw timestamps over 24 hours; older or never-seen series are absent, not zero. Known telemetry gaps are listed below.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "accelerator:busy_percent:avg5m{accelerator=\"gpu-primary\"}",
          "legendFormat": "gpu-primary busy",
          "format": "time_series",
          "instant": true,
          "range": false
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "time() - min(tlast_over_time(accelerator:busy_percent:avg5m{accelerator=\"gpu-primary\"}[24h]))",
          "legendFormat": "gpu-primary rule age",
          "format": "time_series",
          "instant": true,
          "range": false
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "time() - min(tlast_over_time(DCGM_FI_DEV_GPU_UTIL{job=\"dcgm_exporter\",accelerator=\"gpu-primary\"}[24h]))",
          "legendFormat": "gpu-primary hardware age",
          "format": "time_series",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "sum by (accelerator) (label_replace(DCGM_FI_DEV_POWER_USAGE{job=\"dcgm_exporter\",accelerator=\"gpu-primary\"}, \"accelerator\", \"gpu-primary\", \"accelerator\", \"^$\"))",
          "legendFormat": "gpu-primary power",
          "format": "time_series",
          "instant": true,
          "range": false
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "time() - min(tlast_over_time(DCGM_FI_DEV_POWER_USAGE{job=\"dcgm_exporter\",accelerator=\"gpu-primary\"}[24h]))",
          "legendFormat": "gpu-primary power age",
          "format": "time_series",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "sum by (accelerator) (label_replace(rate(vllm:generation_tokens_total{job=\"llm_gpu_engine\",accelerator=\"gpu-primary\"}[5m]), \"accelerator\", \"gpu-primary\", \"accelerator\", \"^$\"))",
          "legendFormat": "gpu-primary decode",
          "format": "time_series",
          "instant": true,
          "range": false
        },
        {
          "refId": "G",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "time() - min(max by (guest) (tlast_over_time(vllm:generation_tokens_total{job=\"llm_gpu_engine\",accelerator=\"gpu-primary\"}[24h])))",
          "legendFormat": "gpu-primary engine age",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "autoSizeColumns": false,
