    {
      "id": 5,
      "type": "grafana-polystat-panel",
      "pluginVersion": "2.1.16",
      "title": "mac-secondary · no engine decode telemetry",
      "description": "Green: busy ≥50% and available telemetry ≤2 minutes old. Amber: busy <50%. Red: any rule, hardware, power, or engine source sample >2 minutes old. MetricsQL tlast_over_time reads raw timestamps over 24 hours; older or never-seen series are absent, not zero. Known telemetry gaps are listed below.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "accelerator:busy_percent:avg5m{accelerator=\"mac-secondary\"}",
          "legendFormat": "mac-secondary busy",
          "format": "time_series",
          "instant": true,
          "range": false
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
