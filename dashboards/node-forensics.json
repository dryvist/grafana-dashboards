        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "rate(node_pressure_io_stalled_seconds_total{job=~\"pve_node_exporter|guest_node_exporter\"}[$__rate_interval])",
          "legendFormat": "{{guest}} {{instance}} I/O stalled",
          "range": true,
          "instant": false,
          "refId": "E"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "rate(node_pressure_irq_stalled_seconds_total{job=~\"pve_node_exporter|guest_node_exporter\"}[$__rate_interval])",
          "legendFormat": "{{guest}} {{instance}} IRQ stalled",
