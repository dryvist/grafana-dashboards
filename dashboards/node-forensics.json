    {
      "id": 5,
      "type": "timeseries",
      "title": "PSI pressure rates",
      "description": "CPU, memory, I/O and IRQ pressure rates. These exact node_pressure_* fields appear in the pinned Node Exporter Full metric set; the guest scrape retains the node_pressure_* family.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "rate(node_pressure_cpu_waiting_seconds_total{job=~\"pve_node_exporter|guest_node_exporter\"}[$__rate_interval])",
          "legendFormat": "{{guest}} {{instance}} CPU wait",
          "range": true,
          "instant": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "rate(node_pressure_memory_waiting_seconds_total{job=~\"pve_node_exporter|guest_node_exporter\"}[$__rate_interval])",
          "legendFormat": "{{guest}} {{instance}} Memory wait",
          "range": true,
          "instant": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "rate(node_pressure_memory_stalled_seconds_total{job=~\"pve_node_exporter|guest_node_exporter\"}[$__rate_interval])",
          "legendFormat": "{{guest}} {{instance}} Memory stalled",
          "range": true,
          "instant": false,
          "refId": "C"
