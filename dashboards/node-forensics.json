    {
      "id": 8,
      "type": "timeseries",
      "title": "Filesystem used",
      "description": "Filesystem capacity from the configured PVE and guest node_exporter jobs, excluding temporary and overlay filesystems.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
