    {
      "id": 10,
      "type": "table",
      "title": "Kernel OOM kills by PVE host",
      "description": "Increase of the node_vmstat_oom_kill counter over the selected dashboard time range. The guest keep-list does not retain node_vmstat metrics. This is a counter, not a kernel log stream.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 46,
        "w": 8,
        "h": 8
