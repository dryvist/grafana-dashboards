        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "rate(node_pressure_io_waiting_seconds_total{job=~\"pve_node_exporter|guest_node_exporter\"}[$__rate_interval])",
          "legendFormat": "{{guest}} {{instance}} I/O wait",
          "range": true,
          "instant": false,
