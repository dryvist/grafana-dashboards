        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "increase(node_vmstat_oom_kill{job=\"pve_node_exporter\"}[$__range])",
