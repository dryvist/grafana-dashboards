{
  "uid": "llm-serving-benchmarks",
  "title": "LLM Serving Benchmarks (beta)",
  "description": "Beta serving telemetry, not controlled benchmark runs. Raw series from the supplied metric inventory; panels will move to llm:* recording rules once they land. Board is arranged for a 1920x1080 kiosk slide; detailed sections follow below. Rates and distributions use the interval variable. Engine model_name and router model labels are selected independently; aliases may differ. Missing measurements remain No data. Direct-engine totals exclude router observations to avoid double counting; MLX is visible only in the router section. No synthetic values or capacity estimates.",
  "schemaVersion": 42,
  "version": 1,
  "editable": true,
  "tags": [
    "llm",
    "serving",
    "benchmarks",
    "beta"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "model",
        "label": "Model (engine names and router aliases)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": "query_result(count by (model) (label_replace(vllm:num_requests_running{job=\"llm_gpu_engine\"}, \"model\", \"$1\", \"model_name\", \"(.+)\") or label_replace(llamacpp:requests_processing{job=\"llm_gpu_engine\"}, \"model\", \"$1\", \"model_name\", \"(.+)\") or litellm_proxy_total_requests_metric_total{model!=\"\"}))",
        "regex": "/model=\"([^\"]+)\"/",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "interval",
        "label": "Rate / distribution window",
        "type": "interval",
        "query": "1m,5m,15m,1h",
        "auto": false,
        "current": {
          "text": "5m",
          "value": "5m"
        },
        "options": [
          {
            "text": "1m",
            "value": "1m",
            "selected": false
          },
          {
            "text": "5m",
            "value": "5m",
            "selected": true
          },
          {
            "text": "15m",
            "value": "15m",
            "selected": false
          },
          {
            "text": "1h",
            "value": "1h",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Board",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total decode tok/s · direct engines",
      "description": "vLLM plus llama.cpp generated tokens. Router observations overlap these engines and are excluded; MLX has no direct engine metric in the inventory.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(vllm:generation_tokens_total{job=\"llm_gpu_engine\",model_name!=\"\",model_name=~\"${model:regex}\"}[$interval]) or rate(llamacpp:tokens_predicted_total{job=\"llm_gpu_engine\",model_name!=\"\",model_name=~\"${model:regex}\"}[$interval]))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: tok/s",
          "decimals": 1,
          "noValue": "No data",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "In-flight · direct engines",
      "description": "Current running vLLM requests plus processing llama.cpp requests; excludes waiting requests and router duplication.",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(vllm:num_requests_running{job=\"llm_gpu_engine\",model_name!=\"\",model_name=~\"${model:regex}\"} or llamacpp:requests_processing{job=\"llm_gpu_engine\",model_name!=\"\",model_name=~\"${model:regex}\"})",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No data",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "TTFT p95 · vLLM",
      "description": "Time to first token, pooled over selected vLLM models. Histogram estimate; router and llama.cpp have no percentile data in the inventory.",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:time_to_first_token_seconds{job=\"llm_gpu_engine\",model_name!=\"\",model_name=~\"${model:regex}\"}[$interval])))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "noValue": "No data",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Serving board · per model / engine · $interval",
      "description": "Live rates, not benchmark-run scores. Only rows with positive total token rate over the selected interval are shown. Router rows are a separate observation layer and must not be added to engine rows. TTFT = time to first token; TPOT = mean time per output token reported by router only; ITL = inter-token latency; E2E = end-to-end request latency. All latency columns are seconds. vLLM lacks per-request TPOT; llama.cpp lacks completed-request and latency counters. Missing cells are No data. Peak is the maximum simultaneous aggregate running/processing requests within interval, sampled every 15 s. TTFT goodput is the share of TTFT observations <= 2.5 s, not a success-rate or multi-SLO goodput. Histogram percentiles are bucket estimates. vLLM request rates and goodput denominators use matching +Inf buckets; interleaved zero samples corrupt sum/count rates, so TTFT uses p50 instead of a mean. Router counters reset about 3000 times/hour across workers: all router rates, averages and activity filtering are unreliable until the source fix. Req/s counts completed E2E observations for vLLM and proxy requests for router; the inventory provides no llama.cpp completion counter.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 19,
        "h": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "instant": true,
          "expr": "sum by (serving_model) (label_replace(sum by (model_name) (rate(vllm:e2e_request_latency_seconds{job=\"llm_gpu_engine\",model_name!=\"\",model_name=~\"${model:regex}\",le=\"+Inf\"}[$interval])), \"serving_model\", \"$1 / vLLM\", \"model_name\", \"(.+)\") or label_replace(sum by (model) (rate(litellm_proxy_total_requests_metric_total{model!=\"\",model=~\"${model:regex}\"}[$interval])), \"serving_model\", \"$1 / router\", \"model\", \"(.+)\"))",
          "range": false
        },
        {
          "refId": "B",
          "format": "table",
          "instant": true,
          "expr": "sum by (serving_model) (label_replace(sum by (model_name) (rate(vllm:generation_tokens_total{job=\"llm_gpu_engine\",model_name!=\"\",model_name=~\"${model:regex}\"}[$interval])), \"serving_model\", \"$1 / vLLM\", \"model_name\", \"(.+)\") or label_replace(sum by (model_name) (rate(llamacpp:tokens_predicted_total{job=\"llm_gpu_engine\",model_name!=\"\",model_name=~\"${model:regex}\"}[$interval])), \"serving_model\", \"$1 / llama.cpp\", \"model_name\", \"(.+)\") or label_replace(sum by (model) (rate(litellm_output_tokens_metric_total{model!=\"\",model=~\"${model:regex}\"}[$interval])), \"serving_model\", \"$1 / router\", \"model\", \"(.+)\"))",
          "range": false
        },
        {
          "refId": "C",
          "format": "table",
          "instant": true,
          "expr": "sum by (serving_model) (label_replace(sum by (model_name) (rate(vllm:generation_tokens_total{job=\"llm_gpu_engine\",model_name!=\"\",model_name=~\"${model:regex}\"}[$interval])) + sum by (model_name) (rate(vllm:prompt_tokens_total{job=\"llm_gpu_engine\",model_name!=\"\",model_name=~\"${model:regex}\"}[$interval])), \"serving_model\", \"$1 / vLLM\", \"model_name\", \"(.+)\") or label_replace(sum by (model_name) (rate(llamacpp:tokens_predicted_total{job=\"llm_gpu_engine\",model_name!=\"\",model_name=~\"${model:regex}\"}[$interval])) + sum by (model_name) (rate(llamacpp:prompt_tokens_total{job=\"llm_gpu_engine\",model_name!=\"\",model_name=~\"${model:regex}\"}[$interval])), \"serving_model\", \"$1 / llama.cpp\", \"model_name\", \"(.+)\") or label_replace(sum by (model) (rate(litellm_total_tokens_metric_total{model!=\"\",model=~\"${model:regex}\"}[$interval])), \"serving_model\", \"$1 / router\", \"model\", \"(.+)\"))",
          "range": false
        },
        {
          "refId": "D",
          "format": "table",
          "instant": true,
          "expr": "sum by (serving_model) (label_replace(sum by (model) (rate(litellm_llm_api_time_to_first_token_metric_sum{model!=\"\",model=~\"${model:regex}\"}[$interval])) / (sum by (model) (rate(litellm_llm_api_time_to_first_token_metric_count{model!=\"\",model=~\"${model:regex}\"}[$interval])) > 0), \"serving_model\", \"$1 / router\", \"model\", \"(.+)\"))",
          "range": false
        },
        {
          "refId": "E",
          "format": "table",
          "instant": true,
          "expr": "sum by (serving_model) (label_replace(histogram_quantile(0.5, sum by (model_name, le) (rate(vllm:time_to_first_token_seconds{job=\"llm_gpu_engine\",model_name!=\"\",model_name=~\"${model:regex}\"}[$interval]))), \"serving_model\", \"$1 / vLLM\", \"model_name\", \"(.+)\"))",
          "range": false
        },
        {
          "refId": "F",
          "format": "table",
          "instant": true,
          "expr": "sum by (serving_model) (label_replace(histogram_quantile(0.99, sum by (model_name, le) (rate(vllm:time_to_first_token_seconds{job=\"llm_gpu_engine\",model_name!=\"\",model_name=~\"${model:regex}\"}[$interval]))), \"serving_model\", \"$1 / vLLM\", \"model_name\", \"(.+)\"))",
          "range": false
        },
        {
          "refId": "G",
          "format": "table",
          "instant": true,
          "expr": "sum by (serving_model) (label_replace(sum by (model) (rate(litellm_deployment_latency_per_output_token_sum{model!=\"\",model=~\"${model:regex}\"}[$interval])) / (sum by (model) (rate(litellm_deployment_latency_per_output_token_count{model!=\"\",model=~\"${model:regex}\"}[$interval])) > 0), \"serving_model\", \"$1 / router\", \"model\", \"(.+)\"))",
          "range": false
        },
        {
          "refId": "H",
          "format": "table",
          "instant": true,
          "expr": "sum by (serving_model) (label_replace(histogram_quantile(0.5, sum by (model_name, le) (rate(vllm:inter_token_latency_seconds{job=\"llm_gpu_engine\",model_name!=\"\",model_name=~\"${model:regex}\"}[$interval]))), \"serving_model\", \"$1 / vLLM\", \"model_name\", \"(.+)\"))",
          "range": false
        },
        {
          "refId": "I",
          "format": "table",
          "instant": true,
          "expr": "sum by (serving_model) (label_replace(histogram_quantile(0.99, sum by (model_name, le) (rate(vllm:inter_token_latency_seconds{job=\"llm_gpu_engine\",model_name!=\"\",model_name=~\"${model:regex}\"}[$interval]))), \"serving_model\", \"$1 / vLLM\", \"model_name\", \"(.+)\"))",
          "range": false
        },
        {
          "refId": "J",
          "format": "table",
          "instant": true,
          "expr": "sum by (serving_model) (label_replace(histogram_quantile(0.99, sum by (model_name, le) (rate(vllm:e2e_request_latency_seconds{job=\"llm_gpu_engine\",model_name!=\"\",model_name=~\"${model:regex}\"}[$interval]))), \"serving_model\", \"$1 / vLLM\", \"model_name\", \"(.+)\"))",
          "range": false
        },
        {
          "refId": "K",
          "format": "table",
          "instant": true,
          "expr": "sum by (serving_model) (label_replace(max_over_time((sum by (model_name) (vllm:num_requests_running{job=\"llm_gpu_engine\",model_name!=\"\",model_name=~\"${model:regex}\"}))[$interval:15s]), \"serving_model\", \"$1 / vLLM\", \"model_name\", \"(.+)\") or label_replace(max_over_time((sum by (model_name) (llamacpp:requests_processing{job=\"llm_gpu_engine\",model_name!=\"\",model_name=~\"${model:regex}\"}))[$interval:15s]), \"serving_model\", \"$1 / llama.cpp\", \"model_name\", \"(.+)\") or label_replace(max_over_time((sum by (model) (litellm_in_flight_requests{model!=\"\",model=~\"${model:regex}\"}))[$interval:15s]), \"serving_model\", \"$1 / router\", \"model\", \"(.+)\"))",
          "range": false
        },
        {
          "refId": "L",
          "format": "table",
          "instant": true,
          "expr": "sum by (serving_model) (label_replace(100 * sum by (model_name) (rate(vllm:time_to_first_token_seconds{job=\"llm_gpu_engine\",model_name!=\"\",model_name=~\"${model:regex}\",le=\"2.5\"}[$interval])) / (sum by (model_name) (rate(vllm:time_to_first_token_seconds{job=\"llm_gpu_engine\",model_name!=\"\",model_name=~\"${model:regex}\",le=\"+Inf\"}[$interval])) > 0), \"serving_model\", \"$1 / vLLM\", \"model_name\", \"(.+)\"))",
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "serving_model",
            "mode": "outerTabular"
          }
        },
        {
          "id": "filterByValue",
          "options": {
            "type": "include",
            "match": "all",
            "filters": [
              {
                "fieldName": "Value #C",
                "config": {
                  "id": "greater",
                  "options": {
                    "value": 0
                  }
                }
              }
            ]
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "serving_model",
                "Value #A",
                "Value #B",
                "Value #C",
                "Value #D",
                "Value #E",
                "Value #F",
                "Value #G",
                "Value #H",
                "Value #I",
                "Value #J",
                "Value #K",
                "Value #L"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "serving_model": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6,
              "Value #G": 7,
              "Value #H": 8,
              "Value #I": 9,
              "Value #J": 10,
              "Value #K": 11,
              "Value #L": 12
            },
            "renameByName": {
              "serving_model": "Model / engine",
              "Value #A": "Req/s",
              "Value #B": "Out tok/s",
              "Value #C": "Total tok/s",
              "Value #D": "Router TTFT avg (s)",
              "Value #E": "TTFT p50 (s)",
              "Value #F": "TTFT p99 (s)",
              "Value #G": "TPOT avg (s)",
              "Value #H": "ITL p50 (s)",
              "Value #I": "ITL p99 (s)",
              "Value #J": "E2E p99 (s)",
              "Value #K": "Peak running",
              "Value #L": "TTFT goodput %"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 3,
          "noValue": "No data",
          "custom": {
            "align": "right",
            "minWidth": 85,
            "width": 93,
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Model / engine"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 290
              },
              {
                "id": "custom.align",
                "value": "left"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(Req/s|Out tok/s|Total tok/s)$"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Peak running"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "TTFT goodput %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Out tok/s",
            "desc": true
          }
        ],
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 6,
      "type": "xychart",
      "pluginVersion": "13.2.4",
      "title": "Throughput vs concurrency",
      "description": "Observed Pareto view, pooled direct engines. X = concurrent running/processing requests at each sample; Y = generated tok/s over interval at the same timestamp. Table frames are joined by Time and renamed before manual XY mapping. These are workload observations, not a controlled concurrency sweep or a measured capacity frontier. Empty engine data stays empty.",
      "gridPos": {
        "x": 19,
        "y": 5,
        "w": 5,
        "h": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "interval": "15s",
      "maxDataPoints": 240,
      "targets": [
        {
          "refId": "A",
          "expr": "sum(vllm:num_requests_running{job=\"llm_gpu_engine\",model_name!=\"\",model_name=~\"${model:regex}\"} or llamacpp:requests_processing{job=\"llm_gpu_engine\",model_name!=\"\",model_name=~\"${model:regex}\"})",
          "legendFormat": "Concurrency",
          "format": "table",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(rate(vllm:generation_tokens_total{job=\"llm_gpu_engine\",model_name!=\"\",model_name=~\"${model:regex}\"}[$interval]) or rate(llamacpp:tokens_predicted_total{job=\"llm_gpu_engine\",model_name!=\"\",model_name=~\"${model:regex}\"}[$interval]))",
          "legendFormat": "Decode tok/s",
          "format": "table",
          "instant": false,
          "range": true
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "Time",
            "mode": "inner"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Value #A",
                "Value #B"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "Value #A": 0,
              "Value #B": 1
            },
            "renameByName": {
              "Value #A": "Concurrency",
              "Value #B": "Decode tok/s"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "custom": {
            "show": "points",
            "pointSize": {
              "fixed": 4
            },
            "axisLabel": "Output tok/s",
            "axisMin": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Concurrency"
            },
            "properties": [
              {
                "id": "custom.axisLabel",
                "value": "Running requests"
              }
            ]
          }
        ]
      },
      "options": {
        "mapping": "manual",
        "series": [
          {
            "name": {
              "fixed": "Direct engines"
            },
            "frame": {
              "matcher": {
                "id": "byIndex",
                "options": 0
              }
            },
            "x": {
              "matcher": {
                "id": "byName",
                "options": "Concurrency"
              }
            },
            "y": {
              "matcher": {
                "id": "byName",
                "options": "Decode tok/s"
              }
            }
          }
        ],
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "vLLM · latency distributions",
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "type": "heatmap",
      "title": "TTFT · histogram observations/s",
      "description": "Pooled selected models. Stored histogram uses the base metric with le, without _bucket. Prometheus heatmap format converts cumulative buckets into disjoint bins; Y is seconds. Color is observations/s over interval.",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (rate(vllm:time_to_first_token_seconds{job=\"llm_gpu_engine\",model_name!=\"\",model_name=~\"${model:regex}\"}[$interval]))",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "range": true
        }
      ],
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Oranges",
          "steps": 64
        },
        "yAxis": {
          "unit": "s",
          "axisPlacement": "left"
        },
        "legend": {
          "show": true
        },
        "tooltip": {
          "mode": "single"
        }
