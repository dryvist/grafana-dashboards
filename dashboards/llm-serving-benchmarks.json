{
  "uid": "llm-serving-benchmarks",
  "title": "LLM Serving Benchmarks (beta)",
  "description": "Beta serving telemetry, not controlled benchmark runs. Board is arranged for a 1920x1080 kiosk slide; detailed sections follow below. Rates and distributions use the interval variable. The vLLM model selector scopes vLLM engine panels only; router models are unfiltered. Missing measurements remain No data. Direct-engine totals exclude router observations to avoid double counting; router rows exclude hosted_vllm and the health-check team. MLX is visible only in the router section. No synthetic values or capacity estimates. llama.cpp is grouped by guest and is not filtered by the model selector. In-flight requests are router-wide, including local traffic and health checks.",
  "schemaVersion": 42,
  "version": 1,
  "editable": true,
  "tags": [
    "llm",
    "serving",
    "benchmarks",
    "beta"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "model",
        "label": "vLLM model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": "query_result(count by (model) (label_replace(vllm:num_requests_running{job=\"llm_gpu_engine\"}, \"model\", \"$1\", \"model_name\", \"(.+)\")))",
        "regex": "/model=\"([^\"]+)\"/",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "description": "Scopes vLLM engine panels only; router and llama.cpp panels are unfiltered."
      },
      {
        "name": "interval",
        "label": "Rate / distribution window",
        "type": "interval",
        "query": "1m,5m,15m,1h",
        "auto": false,
        "current": {
          "text": "5m",
          "value": "5m"
        },
        "options": [
          {
            "text": "1m",
            "value": "1m",
            "selected": false
          },
          {
            "text": "5m",
            "value": "5m",
            "selected": true
          },
          {
            "text": "15m",
            "value": "15m",
            "selected": false
          },
          {
            "text": "1h",
            "value": "1h",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Board",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total decode tok/s · direct engines",
      "description": "vLLM plus llama.cpp generated tokens. Router observations overlap these engines and are excluded; MLX has no direct engine metric in the inventory.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(vllm:generation_tokens_total{job=\"llm_gpu_engine\",model_name!=\"\",model_name=~\"${model:regex}\"}[$interval]) or rate(llamacpp:tokens_predicted_total{job=\"llm_gpu_engine\"}[$interval]))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: tok/s",
          "decimals": 1,
          "noValue": "No data",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "In-flight · direct engines",
      "description": "Current running vLLM requests plus processing llama.cpp requests; excludes waiting requests and router duplication.",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(vllm:num_requests_running{job=\"llm_gpu_engine\",model_name!=\"\",model_name=~\"${model:regex}\"} or llamacpp:requests_processing{job=\"llm_gpu_engine\"})",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No data",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "TTFT p95 · vLLM",
      "description": "Time to first token, pooled over selected vLLM models and accelerators. Histogram bucket estimate. Router percentiles appear in the table and router section; llama.cpp has no latency histogram in the inventory.",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket{job=\"llm_gpu_engine\",model_name!=\"\",model_name=~\"${model:regex}\"}[$interval])))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "noValue": "No data",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Serving board · per model / engine · $interval",
      "description": "Live rates, not benchmark-run scores. Only rows with positive total token rate over the selected interval are shown. Router rows exclude hosted_vllm and the health-check team; MLX remains visible through router metrics. TTFT = time to first token; TPOT = mean time per output token reported by router only; ITL = inter-token latency; E2E = total request latency. All latency columns are seconds. vLLM lacks per-request TPOT; llama.cpp lacks completed-request and latency counters. Missing cells are No data. Peak is the maximum simultaneous aggregate running/processing requests within interval, sampled every 15 s. TTFT goodput is the share of vLLM TTFT observations <= 2.5 s, not a success-rate or multi-SLO goodput. Percentiles use standard histogram buckets pooled by model across replicas and accelerators. Router TTFT and TPOT means use clean sum/count series. Completed req/s counts completed E2E observations for vLLM and total-latency histogram observations for router. Router token counter reset behavior requires separate verification; the histogram migration does not establish their accuracy. llama.cpp rows identify guests rather than models and ignore the model selector. Router per-model peaks are unavailable; see the router-wide in-flight panel.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 19,
        "h": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "instant": true,
          "expr": "sum by (serving_model) (label_replace(sum by (model_name) (rate(vllm:e2e_request_latency_seconds_bucket{job=\"llm_gpu_engine\",model_name!=\"\",model_name=~\"${model:regex}\",le=\"+Inf\"}[$interval])), \"serving_model\", \"$1 / vLLM\", \"model_name\", \"(.+)\") or label_replace(sum by (model) (rate(litellm_request_total_latency_metric_bucket{le=\"+Inf\",api_provider!=\"hosted_vllm\",team!=\"litellm-internal-health-check\"}[$interval])), \"serving_model\", \"$1 / router\", \"model\", \"(.+)\"))",
          "range": false
        },
        {
          "refId": "B",
          "format": "table",
          "instant": true,
          "expr": "sum by (serving_model) (label_replace(sum by (model_name) (rate(vllm:generation_tokens_total{job=\"llm_gpu_engine\",model_name!=\"\",model_name=~\"${model:regex}\"}[$interval])), \"serving_model\", \"$1 / vLLM\", \"model_name\", \"(.+)\") or label_replace(sum by (guest) (rate(llamacpp:tokens_predicted_total{job=\"llm_gpu_engine\"}[$interval])), \"serving_model\", \"$1 / llama.cpp\", \"guest\", \"(.+)\") or label_replace(sum by (model) (rate(litellm_output_tokens_metric_total{api_provider!=\"hosted_vllm\",team!=\"litellm-internal-health-check\",model!=\"\"}[$interval])), \"serving_model\", \"$1 / router\", \"model\", \"(.+)\"))",
          "range": false
        },
        {
          "refId": "C",
          "format": "table",
          "instant": true,
          "expr": "sum by (serving_model) (label_replace(sum by (model_name) (rate(vllm:generation_tokens_total{job=\"llm_gpu_engine\",model_name!=\"\",model_name=~\"${model:regex}\"}[$interval])) + sum by (model_name) (rate(vllm:prompt_tokens_total{job=\"llm_gpu_engine\",model_name!=\"\",model_name=~\"${model:regex}\"}[$interval])), \"serving_model\", \"$1 / vLLM\", \"model_name\", \"(.+)\") or label_replace(sum by (guest) (rate(llamacpp:tokens_predicted_total{job=\"llm_gpu_engine\"}[$interval])) + sum by (guest) (rate(llamacpp:prompt_tokens_total{job=\"llm_gpu_engine\"}[$interval])), \"serving_model\", \"$1 / llama.cpp\", \"guest\", \"(.+)\") or label_replace(sum by (model) (rate(litellm_total_tokens_metric_total{api_provider!=\"hosted_vllm\",team!=\"litellm-internal-health-check\",model!=\"\"}[$interval])), \"serving_model\", \"$1 / router\", \"model\", \"(.+)\"))",
          "range": false
        },
        {
          "refId": "D",
          "format": "table",
          "instant": true,
          "expr": "sum by (serving_model) (label_replace(sum by (model) (rate(litellm_llm_api_time_to_first_token_metric_sum{api_provider!=\"hosted_vllm\",team!=\"litellm-internal-health-check\",model!=\"\"}[$interval])) / (sum by (model) (rate(litellm_llm_api_time_to_first_token_metric_count{api_provider!=\"hosted_vllm\",team!=\"litellm-internal-health-check\",model!=\"\"}[$interval])) > 0), \"serving_model\", \"$1 / router\", \"model\", \"(.+)\"))",
          "range": false
        },
        {
          "refId": "E",
          "format": "table",
          "instant": true,
          "expr": "sum by (serving_model) (label_replace(histogram_quantile(0.5, sum by (model_name, le) (rate(vllm:time_to_first_token_seconds_bucket{job=\"llm_gpu_engine\",model_name!=\"\",model_name=~\"${model:regex}\"}[$interval]))), \"serving_model\", \"$1 / vLLM\", \"model_name\", \"(.+)\") or label_replace(histogram_quantile(0.5, sum by (model, le) (rate(litellm_llm_api_time_to_first_token_metric_bucket{api_provider!=\"hosted_vllm\",team!=\"litellm-internal-health-check\",model!=\"\"}[$interval]))), \"serving_model\", \"$1 / router\", \"model\", \"(.+)\"))",
          "range": false
        },
        {
          "refId": "F",
          "format": "table",
          "instant": true,
          "expr": "sum by (serving_model) (label_replace(histogram_quantile(0.99, sum by (model_name, le) (rate(vllm:time_to_first_token_seconds_bucket{job=\"llm_gpu_engine\",model_name!=\"\",model_name=~\"${model:regex}\"}[$interval]))), \"serving_model\", \"$1 / vLLM\", \"model_name\", \"(.+)\") or label_replace(histogram_quantile(0.99, sum by (model, le) (rate(litellm_llm_api_time_to_first_token_metric_bucket{api_provider!=\"hosted_vllm\",team!=\"litellm-internal-health-check\",model!=\"\"}[$interval]))), \"serving_model\", \"$1 / router\", \"model\", \"(.+)\"))",
          "range": false
        },
        {
          "refId": "G",
          "format": "table",
          "instant": true,
          "expr": "sum by (serving_model) (label_replace(sum by (model) (rate(litellm_deployment_latency_per_output_token_sum{api_provider!=\"hosted_vllm\",team!=\"litellm-internal-health-check\",model!=\"\"}[$interval])) / (sum by (model) (rate(litellm_deployment_latency_per_output_token_count{api_provider!=\"hosted_vllm\",team!=\"litellm-internal-health-check\",model!=\"\"}[$interval])) > 0), \"serving_model\", \"$1 / router\", \"model\", \"(.+)\"))",
          "range": false
        },
        {
          "refId": "H",
          "format": "table",
          "instant": true,
          "expr": "sum by (serving_model) (label_replace(histogram_quantile(0.5, sum by (model_name, le) (rate(vllm:inter_token_latency_seconds_bucket{job=\"llm_gpu_engine\",model_name!=\"\",model_name=~\"${model:regex}\"}[$interval]))), \"serving_model\", \"$1 / vLLM\", \"model_name\", \"(.+)\"))",
          "range": false
        },
        {
          "refId": "I",
          "format": "table",
          "instant": true,
          "expr": "sum by (serving_model) (label_replace(histogram_quantile(0.99, sum by (model_name, le) (rate(vllm:inter_token_latency_seconds_bucket{job=\"llm_gpu_engine\",model_name!=\"\",model_name=~\"${model:regex}\"}[$interval]))), \"serving_model\", \"$1 / vLLM\", \"model_name\", \"(.+)\"))",
          "range": false
        },
        {
          "refId": "J",
          "format": "table",
          "instant": true,
          "expr": "sum by (serving_model) (label_replace(histogram_quantile(0.99, sum by (model_name, le) (rate(vllm:e2e_request_latency_seconds_bucket{job=\"llm_gpu_engine\",model_name!=\"\",model_name=~\"${model:regex}\"}[$interval]))), \"serving_model\", \"$1 / vLLM\", \"model_name\", \"(.+)\") or label_replace(histogram_quantile(0.99, sum by (model, le) (rate(litellm_request_total_latency_metric_bucket{api_provider!=\"hosted_vllm\",team!=\"litellm-internal-health-check\",model!=\"\"}[$interval]))), \"serving_model\", \"$1 / router\", \"model\", \"(.+)\"))",
          "range": false
        },
        {
          "refId": "K",
          "format": "table",
          "instant": true,
          "expr": "sum by (serving_model) (label_replace(max_over_time((sum by (model_name) (vllm:num_requests_running{job=\"llm_gpu_engine\",model_name!=\"\",model_name=~\"${model:regex}\"}))[$interval:15s]), \"serving_model\", \"$1 / vLLM\", \"model_name\", \"(.+)\") or label_replace(max_over_time((sum by (guest) (llamacpp:requests_processing{job=\"llm_gpu_engine\"}))[$interval:15s]), \"serving_model\", \"$1 / llama.cpp\", \"guest\", \"(.+)\"))",
          "range": false
        },
        {
          "refId": "L",
          "format": "table",
          "instant": true,
          "expr": "sum by (serving_model) (label_replace(100 * sum by (model_name) (rate(vllm:time_to_first_token_seconds_bucket{job=\"llm_gpu_engine\",model_name!=\"\",model_name=~\"${model:regex}\",le=\"2.5\"}[$interval])) / (sum by (model_name) (rate(vllm:time_to_first_token_seconds_bucket{job=\"llm_gpu_engine\",model_name!=\"\",model_name=~\"${model:regex}\",le=\"+Inf\"}[$interval])) > 0), \"serving_model\", \"$1 / vLLM\", \"model_name\", \"(.+)\"))",
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "serving_model",
            "mode": "outerTabular"
          }
        },
        {
          "id": "filterByValue",
          "options": {
            "type": "include",
            "match": "all",
            "filters": [
              {
                "fieldName": "Value #C",
                "config": {
                  "id": "greater",
                  "options": {
                    "value": 0
                  }
                }
              }
            ]
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "serving_model",
                "Value #A",
                "Value #B",
                "Value #C",
                "Value #D",
                "Value #E",
                "Value #F",
                "Value #G",
                "Value #H",
                "Value #I",
                "Value #J",
                "Value #K",
                "Value #L"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "serving_model": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6,
              "Value #G": 7,
              "Value #H": 8,
              "Value #I": 9,
              "Value #J": 10,
              "Value #K": 11,
              "Value #L": 12
            },
            "renameByName": {
              "serving_model": "Model / engine",
              "Value #A": "completed req/s",
              "Value #B": "Out tok/s",
              "Value #C": "Total tok/s",
              "Value #D": "Router TTFT avg (s)",
              "Value #E": "TTFT p50 (s)",
              "Value #F": "TTFT p99 (s)",
              "Value #G": "TPOT avg (s)",
              "Value #H": "ITL p50 (s)",
              "Value #I": "ITL p99 (s)",
              "Value #J": "E2E p99 (s)",
              "Value #K": "Peak running",
              "Value #L": "TTFT goodput %"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 3,
          "noValue": "No data",
          "custom": {
            "align": "right",
            "minWidth": 85,
            "width": 93,
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Model / engine"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 290
              },
              {
                "id": "custom.align",
                "value": "left"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(completed req/s|Out tok/s|Total tok/s)$"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Peak running"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "TTFT goodput %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Out tok/s",
            "desc": true
          }
        ],
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 6,
      "type": "xychart",
      "pluginVersion": "13.2.4",
      "title": "Throughput vs concurrency",
      "description": "Observed Pareto view, pooled direct engines. X = concurrent running/processing requests at each sample; Y = generated tok/s over interval at the same timestamp. Table frames are joined by Time and renamed before manual XY mapping. These are workload observations, not a controlled concurrency sweep or a measured capacity frontier. Empty engine data stays empty.",
      "gridPos": {
        "x": 19,
        "y": 5,
        "w": 5,
        "h": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "interval": "15s",
      "maxDataPoints": 240,
      "targets": [
        {
          "refId": "A",
          "expr": "sum(vllm:num_requests_running{job=\"llm_gpu_engine\",model_name!=\"\",model_name=~\"${model:regex}\"} or llamacpp:requests_processing{job=\"llm_gpu_engine\"})",
          "legendFormat": "Concurrency",
          "format": "table",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(rate(vllm:generation_tokens_total{job=\"llm_gpu_engine\",model_name!=\"\",model_name=~\"${model:regex}\"}[$interval]) or rate(llamacpp:tokens_predicted_total{job=\"llm_gpu_engine\"}[$interval]))",
          "legendFormat": "Decode tok/s",
          "format": "table",
          "instant": false,
          "range": true
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "Time",
            "mode": "inner"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Value #A",
                "Value #B"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "Value #A": 0,
              "Value #B": 1
            },
            "renameByName": {
              "Value #A": "Concurrency",
              "Value #B": "Decode tok/s"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "custom": {
            "show": "points",
            "pointSize": {
              "fixed": 4
            },
            "axisLabel": "Output tok/s",
            "axisMin": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Concurrency"
            },
            "properties": [
              {
                "id": "custom.axisLabel",
                "value": "Running requests"
              }
            ]
          }
        ]
      },
      "options": {
        "mapping": "manual",
        "series": [
          {
            "name": {
              "fixed": "Direct engines"
            },
            "frame": {
              "matcher": {
                "id": "byIndex",
                "options": 0
              }
            },
            "x": {
              "matcher": {
                "id": "byName",
                "options": "Concurrency"
              }
            },
            "y": {
              "matcher": {
                "id": "byName",
                "options": "Decode tok/s"
              }
            }
          }
        ],
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "vLLM · latency distributions",
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "type": "heatmap",
      "title": "TTFT · histogram observations/s",
      "description": "Pooled selected models and accelerators. Standard _bucket histogram with le. Prometheus heatmap format converts cumulative buckets into disjoint bins; Y is seconds. Color is observations/s over interval.",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
