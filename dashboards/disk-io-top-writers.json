  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Top 10 containers by write rate",
      "description": "Write rate of the ten busiest LXC guests, from the cumulative pve_lxc_diskwrite counter.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "noValue": "No samples received"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "blocked procs.*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "legendFormat": "LXC {{vmid}}",
          "expr": "topk(10, sum by (vmid) (rate(pve_lxc_diskwrite[$__rate_interval])))",
          "instant": false
        }
      ]
    },
