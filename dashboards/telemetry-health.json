{
  "annotations": {
    "list": []
  },
  "description": "Beta telemetry health: scrape availability, source sample freshness, and remote-write delivery. Raw queries move to telemetry:* recording rules when those land. Freshness measures ingestion timestamps, not payload correctness or request activity. Missing series remain No data; no synthetic zeros.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 2,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Target up ratio by job",
      "description": "Fraction of currently discovered targets whose latest scrape succeeded, grouped by job. A removed target no longer contributes; an absent job shows No data.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "asc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "avg by (job) (up)",
          "legendFormat": "{{job}}",
          "instant": false
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Scrape duration by job",
      "description": "Mean and slowest target scrape duration within each job, in seconds.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "avg by (job) (scrape_duration_seconds)",
          "legendFormat": "{{job}} mean",
          "instant": false
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "max by (job) (scrape_duration_seconds)",
          "legendFormat": "{{job}} slowest",
          "instant": false
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Scrape samples by job",
      "description": "Samples in the latest scrape, summed across targets per job, before and after metric relabeling. These are counts per scrape, not rates.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (job) (scrape_samples_scraped)",
          "legendFormat": "{{job}} scraped",
          "instant": false
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "sum by (job) (scrape_samples_post_metric_relabeling)",
          "legendFormat": "{{job}} retained",
          "instant": false
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Series added per second by job",
      "description": "scrape_series_added is a per-scrape gauge, not a counter. Sum its additions over 5 minutes, then divide by 300 seconds. Missed scrapes contribute no additions; this measures observed series churn, not total active series.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (job) (sum_over_time(scrape_series_added[5m])) / 300",
          "legendFormat": "{{job}}",
          "instant": false
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "vLLM sample age",
      "description": "Oldest visible running-request gauge sample. Scraped every 15 seconds; red at 30 seconds. Absent or stale series outside lookback show No data. An individual missing target can disappear from this aggregate; check target up ratio too.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "max(time() - timestamp(vllm:num_requests_running{job=\"llm_gpu_engine\"}))",
          "legendFormat": "vLLM",
          "instant": true
        }
      ]
    },
