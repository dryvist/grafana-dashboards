      "type": "timeseries",
      "title": "Remote-write pending samples",
      "description": "Current samples waiting in remote-write queues, summed per job. Read alongside lag and failures; missing self-telemetry shows No data.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
