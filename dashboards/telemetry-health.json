    {
      "id": 10,
      "type": "stat",
      "title": "Span-metrics sample age",
      "description": "Span metrics are absent in the supplied inventory. No data is expected until the trace pipeline emits traces_span_metrics_calls_total. Shows the oldest visible sample timestamp, not time since the last span. Scrape interval is not established, so no freshness threshold is assumed.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 16,
        "y": 20,
        "w": 8,
