    {
      "id": 11,
      "type": "timeseries",
      "title": "Remote-write lag by job",
      "description": "Largest timestamp gap between the newest ingested sample and each remote-write queue's highest sent timestamp, per job. Match queues to their writer by job and instance, retaining the worst queue. Negative gaps from scrape timing are clamped to zero. A missing writer or queue shows No data; this measures backlog, not wall-clock data age.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "max by (job) (clamp_min(prometheus_remote_storage_highest_timestamp_in_seconds - on (job, instance) group_right prometheus_remote_storage_queue_highest_sent_timestamp_seconds, 0))",
          "legendFormat": "{{job}} worst queue",
          "instant": false
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Remote-write failed samples per second",
      "description": "Counter-reset-aware failed-sample rate summed across remote-write queues per job over 5 minutes. An absent counter shows No data, not zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
