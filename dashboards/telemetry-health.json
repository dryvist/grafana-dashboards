          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (job) (rate(prometheus_remote_storage_samples_failed_total[5m]))",
          "legendFormat": "{{job}}",
          "instant": false
        }
      ]
    },
