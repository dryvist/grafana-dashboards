  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Pool capacity",
      "collapsed": false,
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 1},
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "$pool fill %",
      "description": "Share of each pool in use, per node. Colors follow the fill thresholds.",
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "repeat": "pool",
      "repeatDirection": "h",
      "maxPerRow": 6,
      "gridPos": {"x": 0, "y": 1, "w": 6, "h": 4},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "noValue": "No pool samples",
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 70}, {"color": "orange", "value": 80}, {"color": "red", "value": 90}]}
        },
        "overrides": []
      },
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "editorMode": "code", "instant": true, "range": false, "legendFormat": "{{instance}}", "expr": "pve_zpool_cap_percent{instance=~\"$node(:.*)?\",pool=~\"$pool\"}"}
      ]
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "$pool fill gauge",
      "description": "Same fill percentage as the stat, shown as a gauge.",
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "repeat": "pool",
      "repeatDirection": "h",
      "maxPerRow": 6,
      "gridPos": {"x": 0, "y": 5, "w": 6, "h": 6},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "noValue": "No pool samples",
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 70}, {"color": "orange", "value": 80}, {"color": "red", "value": 90}]}
        },
        "overrides": []
      },
      "options": {"orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showThresholdLabels": false, "showThresholdMarkers": true},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "editorMode": "code", "instant": true, "range": false, "legendFormat": "{{instance}}", "expr": "pve_zpool_cap_percent{instance=~\"$node(:.*)?\",pool=~\"$pool\"}"}
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Pool fill % over time",
      "description": "Fill percentage over the dashboard time range. Dashed lines mark the 70, 80 and 90 percent thresholds.",
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "gridPos": {"x": 0, "y": 11, "w": 12, "h": 8},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "noValue": "No pool samples received",
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": false, "thresholdsStyle": {"mode": "dashed"}},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 70}, {"color": "orange", "value": 80}, {"color": "red", "value": 90}]}
        },
        "overrides": []
      },
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "editorMode": "code", "instant": false, "range": true, "legendFormat": "{{instance}} {{pool}}", "expr": "pve_zpool_cap_percent{instance=~\"$node(:.*)?\",pool=~\"$pool\"}"}
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Days to full (7-day trend)",
      "description": "Free bytes divided by the 7-day shrink rate. Shows growing/flat when free space is not shrinking.",
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "gridPos": {"x": 12, "y": 11, "w": 6, "h": 8},
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "min": 0,
          "noValue": "growing/flat",
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 30}, {"color": "yellow", "value": 90}, {"color": "green", "value": 365}]}
        },
        "overrides": []
      },
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "editorMode": "code", "instant": true, "range": false, "legendFormat": "{{instance}} {{pool}}", "expr": "pve_zpool_free_bytes{instance=~\"$node(:.*)?\",pool=~\"$pool\"} / (-deriv(pve_zpool_free_bytes{instance=~\"$node(:.*)?\",pool=~\"$pool\"}[7d]) > 0) / 86400"}
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Free bytes in 7 days (predict_linear)",
      "description": "Linear forecast of free bytes one week ahead, fitted over the last 7 days.",
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "gridPos": {"x": 18, "y": 11, "w": 6, "h": 8},
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "No pool samples received",
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 0}]}
        },
        "overrides": []
      },
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "editorMode": "code", "instant": true, "range": false, "legendFormat": "{{instance}} {{pool}}", "expr": "predict_linear(pve_zpool_free_bytes{instance=~\"$node(:.*)?\",pool=~\"$pool\"}[7d], 604800)"}
      ]
    },
    {
      "id": 7,
      "type": "row",
      "title": "Pool size, health, and scrub",
      "collapsed": false,
      "gridPos": {"x": 0, "y": 19, "w": 24, "h": 1},
      "panels": []
    },
    {
      "id": 8,
      "type": "table",
      "title": "Pool size, used, and free",
      "description": "Pool size in bytes. Used is allocated space; free is what remains.",
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "fieldConfig": {
        "defaults": {"unit": "bytes", "noValue": "No pool samples received", "custom": {"align": "auto", "cellOptions": {"type": "auto"}}},
        "overrides": []
      },
      "options": {"showHeader": true, "cellHeight": "sm", "footer": {"show": false, "reducer": ["sum"], "fields": "", "countRows": false}},
      "transformations": [
        {"id": "merge", "options": {}},
        {"id": "organize", "options": {"excludeByName": {"Time": true}, "indexByName": {}, "renameByName": {"instance": "Node", "pool": "Pool", "Value #A": "Size", "Value #B": "Used", "Value #C": "Free"}}}
      ],
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "editorMode": "code", "instant": true, "range": false, "format": "table", "legendFormat": "", "expr": "max by (instance, pool) (pve_zpool_size_bytes{instance=~\"$node(:.*)?\",pool=~\"$pool\"})"},
        {"refId": "B", "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "editorMode": "code", "instant": true, "range": false, "format": "table", "legendFormat": "", "expr": "max by (instance, pool) (pve_zpool_alloc_bytes{instance=~\"$node(:.*)?\",pool=~\"$pool\"})"},
        {"refId": "C", "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "editorMode": "code", "instant": true, "range": false, "format": "table", "legendFormat": "", "expr": "max by (instance, pool) (pve_zpool_free_bytes{instance=~\"$node(:.*)?\",pool=~\"$pool\"})"}
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Pool health state",
      "description": "Health state from the textfile collector and from node_exporter. Two rows for one pool mean the sources disagree.",
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "fieldConfig": {
        "defaults": {"noValue": "No pool health samples", "custom": {"align": "auto", "cellOptions": {"type": "auto"}}},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "state"},
            "properties": [
              {"id": "mappings", "value": [{"type": "value", "options": {"ONLINE": {"text": "ONLINE", "color": "green", "index": 0}, "DEGRADED": {"text": "DEGRADED", "color": "orange", "index": 1}, "FAULTED": {"text": "FAULTED", "color": "red", "index": 2}, "UNAVAIL": {"text": "UNAVAIL", "color": "red", "index": 3}, "REMOVED": {"text": "REMOVED", "color": "orange", "index": 4}, "SUSPENDED": {"text": "SUSPENDED", "color": "red", "index": 5}}}]},
              {"id": "custom.cellOptions", "value": {"type": "color-text"}}
            ]
          }
        ]
      },
      "options": {"showHeader": true, "cellHeight": "sm", "footer": {"show": false, "reducer": ["sum"], "fields": "", "countRows": false}},
      "transformations": [
        {"id": "merge", "options": {}},
        {"id": "organize", "options": {"excludeByName": {"Time": true, "Value #A": true, "Value #B": true}, "indexByName": {}, "renameByName": {"instance": "Node", "pool": "Pool", "state": "state"}}}
      ],
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "editorMode": "code", "instant": true, "range": false, "format": "table", "legendFormat": "", "expr": "pve_zpool_health{instance=~\"$node(:.*)?\",pool=~\"$pool\"}"},
        {"refId": "B", "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "editorMode": "code", "instant": true, "range": false, "format": "table", "legendFormat": "", "expr": "label_replace(label_replace(node_zfs_zpool_state{instance=~\"$node(:.*)?\",zpool=~\"$pool\"}, \"pool\", \"$1\", \"zpool\", \"(.*)\"), \"zpool\", \"\", \"zpool\", \".*\")"}
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Scrub, scan errors, and fragmentation",
      "description": "Latest scan state, progress, errors and end time per pool, with fragmentation.",
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "gridPos": {"x": 0, "y": 28, "w": 24, "h": 8},
      "fieldConfig": {
        "defaults": {"noValue": "No scan or fragmentation samples", "custom": {"align": "auto", "cellOptions": {"type": "auto"}}},
        "overrides": [
          {"matcher": {"id": "byName", "options": "Last scan end"}, "properties": [{"id": "unit", "value": "dateTimeAsLocal"}]},
          {"matcher": {"id": "byName", "options": "Fragmentation %"}, "properties": [{"id": "unit", "value": "percent"}, {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 50}, {"color": "red", "value": 75}]}}, {"id": "custom.cellOptions", "value": {"type": "color-background"}}]},
          {"matcher": {"id": "byName", "options": "Scan errors"}, "properties": [{"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, {"id": "custom.cellOptions", "value": {"type": "color-background"}}]},
          {"matcher": {"id": "byName", "options": "Scan %"}, "properties": [{"id": "unit", "value": "percent"}]}
        ]
      },
      "options": {"showHeader": true, "cellHeight": "sm", "footer": {"show": false, "reducer": ["sum"], "fields": "", "countRows": false}},
      "transformations": [
        {"id": "merge", "options": {}},
        {"id": "organize", "options": {"excludeByName": {"Time": true}, "indexByName": {}, "renameByName": {"instance": "Node", "pool": "Pool", "Value #A": "Scan state", "Value #B": "Scan %", "Value #C": "Scan errors", "Value #D": "Last scan end", "Value #E": "Fragmentation %"}}}
      ],
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "editorMode": "code", "instant": true, "range": false, "format": "table", "legendFormat": "", "expr": "max by (instance, pool) (pve_zpool_scan_state{instance=~\"$node(:.*)?\",pool=~\"$pool\"})"},
        {"refId": "B", "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "editorMode": "code", "instant": true, "range": false, "format": "table", "legendFormat": "", "expr": "max by (instance, pool) (pve_zpool_scan_pct{instance=~\"$node(:.*)?\",pool=~\"$pool\"})"},
        {"refId": "C", "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "editorMode": "code", "instant": true, "range": false, "format": "table", "legendFormat": "", "expr": "max by (instance, pool) (pve_zpool_scan_errors{instance=~\"$node(:.*)?\",pool=~\"$pool\"})"},
        {"refId": "D", "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "editorMode": "code", "instant": true, "range": false, "format": "table", "legendFormat": "", "expr": "max by (instance, pool) (pve_zpool_scan_end_time_seconds{instance=~\"$node(:.*)?\",pool=~\"$pool\"})"},
        {"refId": "E", "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "editorMode": "code", "instant": true, "range": false, "format": "table", "legendFormat": "", "expr": "max by (instance, pool) (pve_zpool_frag_percent{instance=~\"$node(:.*)?\",pool=~\"$pool\"})"}
      ]
