  "templating": {
    "list": [
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "victoriametrics"},
        "query": "label_values(node_cpu_seconds_total, instance)",
        "regex": "/^([^:]+)/",
        "includeAll": true,
        "multi": true,
        "refresh": 1,
        "current": {"text": "All", "value": "$__all"}
      },
      {
        "name": "pool",
        "label": "Pool",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "victoriametrics"},
        "query": "label_values(pve_zpool_cap_percent{instance=~\"$node(:.*)?\"}, pool)",
        "includeAll": true,
        "multi": true,
        "refresh": 1,
        "current": {"text": "All", "value": "$__all"}
      },
      {
        "name": "device",
        "label": "Drive",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "victoriametrics"},
        "query": "label_values(smartmon_device_active{instance=~\"$node(:.*)?\"}, disk)",
        "includeAll": true,
        "multi": true,
        "refresh": 1,
        "current": {"text": "All", "value": "$__all"}
      }
    ]
