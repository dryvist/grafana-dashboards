    {
      "id": 16,
      "type": "stat",
      "title": "Interactive TTFT p95 (7 days)",
      "description": "95th percentile time-to-first-token for interactive caller aliases over 7 days.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "x": 16, "y": 47, "w": 8, "h": 5 },
      "fieldConfig": {
