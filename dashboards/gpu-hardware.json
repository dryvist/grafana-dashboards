  "refresh": "30s",
  "schemaVersion": 42,
  "tags": ["gpu", "hardware"],
  "templating": {
    "list": [
      {
        "name": "interactive_callers",
        "type": "custom",
        "label": "Interactive callers",
        "description": "Holds the interactive caller key aliases as a regex.",
        "query": ".*",
        "current": {"selected": true, "text": ".*", "value": ".*"},
        "options": [{"selected": true, "text": ".*", "value": ".*"}],
        "includeAll": false,
        "multi": false,
        "skipUrlSync": false
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "GPU Hardware",
  "uid": "gpu-hardware",
  "version": 1
}
